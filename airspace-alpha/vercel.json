{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/atlas.js": {
      "includeFiles": "atlas/*"
    },
    "api/index.js": {
      "includeFiles": "api/chunk*.txt",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/atlas", "destination": "/api/atlas" },
    { "source": "/atlas/:asset", "destination": "/api/atlas?asset=:asset" },
    { "source": "/(.*)", "destination": "/api/index?path=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
